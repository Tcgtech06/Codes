rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuthenticated() {
      return request.auth != null;
    }

    // USERS: Users can only read and write their own profile data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // CHATS: Chat history is private to the user who created it.
    match /chats/{chatId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // COMPANIES: Anyone can read (for AI search to work). 
    // WARNING: Master Admin currently uses a hardcoded password and does NOT use Firebase Auth. 
    // Allowing public write temporarily so Admin panel doesn't break, but this MUST BE FIXED for security.
    match /companies/{companyId} {
      allow read: if true;
      allow write: if true; 
    }
    
    // ADS: Public read. Public write temporarily for Admin panel.
    match /ads/{adId} {
      allow read: if true;
      allow write: if true;
    }

    // DEFAULT: Secure by default. Block everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
